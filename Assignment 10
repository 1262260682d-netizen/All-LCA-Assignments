#include<stdio.h>
#include <time.h>

int main()
{
    int year, month, days, i, day;
    int firstDay;
    char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int daysInMonth[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    printf("Enter year: ");
    scanf("%d", &year);

    // Check leap year
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
    {
        daysInMonth[1] = 29;
    }

    // Find first day of the year
    struct tm date = {0};
    date.tm_year = year - 1900;
    date.tm_mon = 0;
    date.tm_mday = 1;

    mktime(&date);
    firstDay = date.tm_wday;

    // Print all months
    for (month = 0; month < 12; month++)
    {
        printf("\n\n       %s %d\n", months[month], year);
        printf("Sun Mon Tue Wed Thu Fri Sat\n");

        // Print spaces before the first day
        for (i = 0; i < firstDay; i++)
        {
            printf("    ");
        }

        days = daysInMonth[month];

        // Print dates
        for (day = 1; day <= days; day++)
        {
            printf("%3d ", day);

            if ((firstDay + day) % 7 == 0)
            {
                printf("\n");
            }
        }

        // Calculate first day of next month
        firstDay = (firstDay + days) % 7;
    }

    printf("\n");
    return 0;
}
