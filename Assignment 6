#include<stdio.h>

unsigned long factorial_iterative(int n)
{

unsigned long fact = 1;
int i;

for(i=1;i<=n;i++)
{
fact=fact*i;
}

  return fact;
}

unsigned long factorial_recursive(int n)
{

if (n==0 || n==1)
    return 1;

    return n* factorial_recursive(n-1)

}
